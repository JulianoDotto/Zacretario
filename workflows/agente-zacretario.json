    {
      "id": "c661a07b-9df2-456b-aa98-3cf7bd087703",
      "name": "Ler histórico",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        200,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(string_agg(CASE role WHEN 'user' THEN 'Pessoa: ' ELSE 'Zacretário: ' END || text, E'\\n' ORDER BY created_at), '') AS history\nFROM (\n  SELECT role, text, created_at FROM conversation\n  WHERE user_key = $1 AND created_at > now() - interval '24 hours'\n  ORDER BY created_at DESC LIMIT 20\n) recent",
        "options": {
          "queryReplacement": "={{ $json.user_key }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "5m9yHkKV7JeOd48c",
          "name": "Postgres Zacretário"
        }
      }
    },
