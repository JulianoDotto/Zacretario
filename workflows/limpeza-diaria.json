    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (DELETE FROM conversation WHERE created_at < now() - interval '48 hours' RETURNING 1), p AS (DELETE FROM processed_messages WHERE received_at < now() - interval '7 days' RETURNING 1) SELECT (SELECT count(*) FROM c) AS conversa, (SELECT count(*) FROM p) AS mensagens;",
        "options": {}
      },
