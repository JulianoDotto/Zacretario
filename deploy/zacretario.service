[Unit]
Description=Zacretario WhatsApp secretary bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zacretario
Group=zacretario
# Settings come from /opt/zacretario/.env via the working directory. No EnvironmentFile=:
# systemd would strip the quotes from JSON values such as ALLOWED_USERS.
WorkingDirectory=/opt/zacretario
# Bound to localhost: only Caddy (same machine) can reach it.
ExecStart=/opt/zacretario/.venv/bin/uvicorn zacretario.main:get_app --factory --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
