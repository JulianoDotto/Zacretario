# Copy to infra/.env on the server and fill every value.
# Generate each secret with: openssl rand -hex 32

DOMAIN=dotton8n.com.br

# Postgres superuser (only for maintenance)
POSTGRES_PASSWORD=

# One database user per app, created on the first start by postgres/init.sh
N8N_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=
ZACRETARIO_DB_PASSWORD=

# Encrypts the credentials stored in n8n. Losing it means re-entering every credential.
N8N_ENCRYPTION_KEY=

# The key that controls the WhatsApp number through Evolution API
EVOLUTION_API_KEY=
