www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# The WhatsApp entry webhook is called by Evolution API over the internal
	# Docker network (http://n8n:5678/...). From the internet it does not exist,
	# so nobody can post fake messages to the bot.
	respond /webhook/whatsapp-entrada* 404
	respond /webhook-test/whatsapp-entrada* 404

	reverse_proxy n8n:5678
}

# Test n8n for the Kanban agent. It has no WhatsApp, so the entry webhook is
# closed here too: a fake message from the internet would spend test API credits.
teste.{$DOMAIN} {
	respond /webhook/whatsapp-entrada* 404
	respond /webhook-test/whatsapp-entrada* 404

	reverse_proxy n8n-teste:5678
}
