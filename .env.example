# Copy to .env and fill in. All values below are fake placeholders.

# Neon connection string, see docs/local-setup.md#neon-database
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Postgres used by the tests, see docs/local-setup.md#docker-test-database
TEST_DATABASE_URL=postgresql+psycopg://zacretario:zacretario@localhost:5433/zacretario_test

# Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-fake
ANTHROPIC_MODEL=claude-sonnet-5-5

# Meta / WhatsApp Cloud API, see docs/local-setup.md#meta--whatsapp
WHATSAPP_ACCESS_TOKEN=fake-access-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_APP_SECRET=fake-app-secret
WHATSAPP_VERIFY_TOKEN=any-string-you-choose
WHATSAPP_API_VERSION=v23.0

# Allowed users as JSON: phone (E.164, no +) -> name
ALLOWED_USERS={"5511900000000":"juliano"}

# Google OAuth client, see docs/local-setup.md#google-cloud-calendar
GOOGLE_CLIENT_ID=fake-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-client-secret

TIMEZONE=America/Sao_Paulo
HISTORY_LIMIT=20
HISTORY_MAX_AGE_HOURS=24
